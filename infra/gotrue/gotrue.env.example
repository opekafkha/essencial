# Variables para el servicio GoTrue en Railway ("+ New → Docker Image" con
# ghcr.io/supabase/gotrue:v2.158.1 — este tag es intencional, NO usar uno más
# nuevo sin probarlo antes: versiones más recientes (ej. v2.180.0) tienen un
# bug conocido migrando contra una Postgres nueva ("type auth.factor_type
# does not exist" en la migración add_mfa_phone_config).
# Este servicio NO necesita dominio público: solo lo consume el backend por
# red privada de Railway (GOTRUE_URL en backend/.env).

GOTRUE_API_HOST=0.0.0.0
GOTRUE_API_PORT=9999

# URL pública por la que los clientes llegan a GoTrue — en este stack es el
# backend actuando de proxy en /auth/v1 (backend/src/routes/auth-proxy.routes.ts).
API_EXTERNAL_URL=https://<tu-backend>.up.railway.app/auth/v1

GOTRUE_DB_DRIVER=postgres
# Referencia a la Postgres gestionada por Railway (mismo proyecto):
GOTRUE_DB_DATABASE_URL=${{Postgres.DATABASE_URL}}

GOTRUE_SITE_URL=https://<tu-web>.up.railway.app
GOTRUE_URI_ALLOW_LIST=https://<tu-web>.up.railway.app

GOTRUE_DISABLE_SIGNUP=false

# Generar un secreto largo y aleatorio (ej. `openssl rand -base64 48`).
# Debe ser IDÉNTICO al GOTRUE_JWT_SECRET del servicio backend.
GOTRUE_JWT_SECRET=
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_ADMIN_ROLES=service_role

GOTRUE_EXTERNAL_EMAIL_ENABLED=true
# Sin SMTP configurado todavía: autoconfirma el correo al registrarse.
# La pantalla "revisa tu correo" del frontend deja de ser necesaria pero no
# rompe nada. Cuando haya SMTP real, poner esto en false y configurar
# GOTRUE_SMTP_*.
GOTRUE_MAILER_AUTOCONFIRM=true
