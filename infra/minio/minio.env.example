# Variables para el servicio MinIO en Railway ("+ New → Docker Image" con
# minio/minio). Start command: minio server /data --address ":9000" --console-address ":9001"
# Adjuntar un volumen persistente en /data. Generar dominio público en el
# puerto 9000 (API S3) y opcionalmente en 9001 (consola web de MinIO).
#
# Hoy ningún código consume este servicio todavía — queda listo para cuando
# se implemente una feature de archivos, vía un cliente S3 estándar
# (ej. @aws-sdk/client-s3) apuntando a este endpoint.

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
