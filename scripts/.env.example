# URL pública del backend desplegado (o http://localhost:3001 en local) —
# sirve /auth/v1/* como proxy hacia GoTrue.
BACKEND_URL=http://localhost:3001

# JWT service_role generado con:
#   tsx backend/scripts/mint-service-role-jwt.ts <GOTRUE_JWT_SECRET>
# Nunca pegar esto en el frontend ni en ningún servicio desplegado.
SERVICE_ROLE_JWT=
