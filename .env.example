PORT=3001

# Connection string de la Postgres de Railway (plugin gestionado) — en Railway
# se referencia como ${{Postgres.DATABASE_URL}}. No hay RLS en este stack: la
# autorización real vive en requireAuth/requireRole.
DATABASE_URL=

# URL interna (red privada de Railway) del servicio GoTrue, ej:
# http://gotrue.railway.internal:9999 — no exponer GoTrue con dominio público.
GOTRUE_URL=

# Debe ser IDÉNTICO al GOTRUE_JWT_SECRET configurado en el servicio GoTrue.
# El backend valida los JWT localmente contra este secreto (sin llamada de red).
GOTRUE_JWT_SECRET=

DAILY_API_KEY=

WEB_APP_URL=http://localhost:5173

# Orígenes permitidos por CORS, separados por coma (apps/web y apps/desktop en dev).
ALLOWED_ORIGINS=http://localhost:5173
